<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash (before Flutter starts): the WattWise mark on the ink colour.
     The Flutter splash (lib/splash.dart) draws the same mark in the same place, so there is no jump. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ww_ink"/>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_logo"/>
    </item>
</layer-list>
