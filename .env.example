# Copy this file to .env and change values if needed. Never commit .env.
# WATTWISE_DB=wattwise.db
# COMFORT_MIN_TEMP_C=22
# COMFORT_MAX_TEMP_C=27
# APPROVAL_TIMEOUT_S=45
# WASTE_EMPTY_S=3
# STALE_READING_S=15
# LLM planner (optional). Without a key, the rule-based planner does everything.
# The key is read from here, never from the code. Never commit .env.
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic        # or: none
# LLM_MODEL=claude-opus-5-5
# LLM_MONTHLY_BUDGET_USD=5      # spending cap: over it, the agent uses rules only
# LLM_TIMEOUT_S=30              # late answer -> rule-based fallback
# Weather (Open-Meteo, free, no key). Default location: Irbid.
# WEATHER_ENABLED=1
# WEATHER_LAT=32.56
# WEATHER_LON=35.85
# WEATHER_PLACE=Irbid
